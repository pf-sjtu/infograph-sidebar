{
	"name": "infograph-sidebar",
	"version": "0.4.3",
	"description": "Sidebar infographics for research notes: logic overview + data panels, source anchors, configurable auto-generation",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:esbuild": "node esbuild.config.mjs production",
		"bump-build": "node scripts/bump-build.mjs",
		"deploy": "node scripts/deploy.mjs",
		"release": "node esbuild.config.mjs production && node scripts/deploy.mjs",
		"test:sanitize": "node --experimental-strip-types scripts/test-sanitize.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@eslint/json": "2.0.1",
		"@types/node": "^26.2.0",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "0.4.1",
		"globals": "17.11.0",
		"jiti": "2.7.0",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "8.67.0"
	},
	"dependencies": {
		"@antv/infographic": "^0.2.19",
		"obsidian": "^1.13.1"
	}
}
